{
  "schema_version": 1,
  "id": "hypertension-equivalence",
  "name": "Hypertension equivalence: Synthea vs psynthea",
  "description": "Deterministic end-to-end scientific validation of the hypertension module.",
  "cohort": {
    "population": 100,
    "seed": 42,
    "modules_dir": "../resources/synthea/modules",
    "modules": [
      "hypertension"
    ],
    "module_files": [],
    "reference_date": "2024-12-31",
    "min_age": 18,
    "max_age": 90,
    "parameters": {
      "profile": {
        "country": "ES"
      }
    },
    "step_days": 1,
    "years_of_history": 10,
    "wellness_encounters": true,
    "vitals": true,
    "mortality": true,
    "keystone": true,
    "ground_truth": false,
    "output_format": "csv",
    "observation_start_date": "2020-01-01",
    "observation_end_date": "2024-12-31"
  },
  "simulators": [
    {
      "kind": "synthea",
      "command": [
        "./gradlew",
        "run"
      ],
      "working_directory": "../../synthea",
      "output_subdirectory": "synthea",
      "timeout_seconds": 3600,
      "environment": {},
      "arguments": {
        "command_arguments": [
          "--args=-p {population} -s {seed} -m {modules} -r {reference_date_compact} -a {age_range} --exporter.baseDirectory={output_dir} --exporter.csv.export=true --exporter.fhir.export=false"
        ],
        "discover_outputs": true
      },
      "expected_output_files": [
        "csv/patients.csv",
        "csv/conditions.csv",
        "csv/encounters.csv"
      ]
    },
    {
      "kind": "psynthea",
      "command": [
        "psynthea"
      ],
      "working_directory": "../../psynthea",
      "output_subdirectory": "psynthea",
      "timeout_seconds": 3600,
      "environment": {
        "PYTHONHASHSEED": "0"
      },
      "arguments": {
        "discover_outputs": true
      },
      "expected_output_files": [
        "patients.csv",
        "conditions.csv",
        "encounters.csv"
      ]
    }
  ],
  "output_root": "../runs",
  "report_formats": [
    "html",
    "json"
  ],
  "tags": [
    "hypertension",
    "equivalence",
    "phase-6"
  ],
  "metadata": {
    "protocol": {
      "name": "IRYCIS Psynthea Scientific Validation",
      "version": 1
    },
    "validation": {
      "alpha": 0.05,
      "confidence_level": 0.95,
      "fdr_method": "benjamini-hochberg",
      "continuous_effect_margin": 0.2,
      "categorical_effect_margin": 0.1
    },
    "analysis_window": {
      "design": "five-year closed observation window with prior history available for baseline disease ascertainment",
      "start_date": "2020-01-01",
      "end_date": "2024-12-31",
      "boundary_convention": "inclusive",
      "lookback_available_years": 5,
      "rationale": "The ten-year generated history is partitioned into an approximately five-year pre-observation lookback period and a five-year analysis window. The lookback supports identification of conditions documented before cohort entry, while the analysis window supports period prevalence and cumulative incidence estimates without inferring dates from years_of_history."
    }
  }
}