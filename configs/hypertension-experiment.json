{
  "schema_version": 1,
  "id": "hypertension-equivalence",
  "name": "Hypertension equivalence: Synthea vs psynthea",
  "description": "Deterministic end-to-end scientific validation of the hypertension module.",
  "cohort": {
    "population": 100,
    "seed": 42,
    "modules": [
      "hypertension"
    ],
    "reference_date": "2024-12-31",
    "min_age": 18,
    "max_age": 90,
    "parameters": {
      "profile": {
        "country": "ES"
      }
    }
  },
  "simulators": [
    {
      "kind": "synthea",
      "command": [
        "./gradlew",
        "run"
      ],
      "working_directory": "../../synthea",
      "output_subdirectory": "synthea",
      "timeout_seconds": 3600,
      "environment": {},
      "arguments": {
        "command_arguments": [
          "--args=-p {population} -s {seed} -m {modules} -r 20241231 -a 18-90 --exporter.baseDirectory={output_dir} --exporter.csv.export=true --exporter.fhir.export=false"
        ],
        "discover_outputs": true
      },
      "expected_output_files": [
        "csv/patients.csv",
        "csv/conditions.csv",
        "csv/encounters.csv"
      ]
    },
    {
      "kind": "psynthea",
      "command": [
        "psynthea"
      ],
      "working_directory": "../../psynthea",
      "output_subdirectory": "psynthea",
      "timeout_seconds": 3600,
      "environment": {
        "PYTHONHASHSEED": "0"
      },
      "arguments": {
        "command_arguments": [
          "generate",
          "-p",
          "{population}",
          "-m",
          "{modules}",
          "-d",
          "/Users/pgt01/IRYCIS/synthea/src/main/resources/modules",
          "-o",
          "{output_dir}",
          "--seed",
          "{seed}",
          "--format",
          "csv",
          "--min-age",
          "{min_age}",
          "--max-age",
          "{max_age}",
          "--end-date",
          "{reference_date}"
        ],
        "discover_outputs": true
      },
      "expected_output_files": [
        "patients.csv",
        "conditions.csv",
        "encounters.csv"
      ]
    }
  ],
  "output_root": "../runs",
  "report_formats": [
    "html",
    "json"
  ],
  "tags": [
    "hypertension",
    "equivalence",
    "phase-6"
  ],
  "metadata": {
    "protocol": {
      "name": "IRYCIS Psynthea Scientific Validation",
      "version": 1
    },
    "validation": {
      "alpha": 0.05,
      "confidence_level": 0.95,
      "fdr_method": "benjamini-hochberg",
      "continuous_effect_margin": 0.2,
      "categorical_effect_margin": 0.1
    }
  }
}