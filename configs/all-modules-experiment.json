{
  "schema_version": 1,
  "id": "all-modules-compatibility",
  "name": "All-modules combined compatibility experiment",
  "description": "Deterministic combined execution of all supported root modules for Synthea and Psynthea.",
  "cohort": {
    "population": 1,
    "seed": 42,
    "modules_dir": "../resources/synthea/modules",
    "modules": [],
    "module_files": [],
    "reference_date": "2024-12-31",
    "min_age": 18,
    "max_age": 90,
    "parameters": {
      "profile": {
        "country": "ES"
      }
    },
    "step_days": 1,
    "years_of_history": 10,
    "wellness_encounters": true,
    "vitals": true,
    "mortality": true,
    "keystone": true,
    "ground_truth": false,
    "output_format": "csv",
    "module_selection": "all"
  },
  "simulators": [
    {
      "kind": "synthea",
      "command": [
        "./gradlew",
        "run"
      ],
      "working_directory": "../../synthea",
      "output_subdirectory": "synthea",
      "timeout_seconds": 3600,
      "environment": {},
      "arguments": {
        "command_arguments": [
          "--args=-p {population} -s {seed} -m {modules} -r 20241231 -a 18-90 --exporter.baseDirectory={output_dir} --exporter.csv.export=true --exporter.fhir.export=false"
        ],
        "discover_outputs": true
      },
      "expected_output_files": [
        "csv/patients.csv",
        "csv/encounters.csv"
      ]
    },
    {
      "kind": "psynthea",
      "command": [
        "psynthea"
      ],
      "working_directory": "../../psynthea",
      "output_subdirectory": "psynthea",
      "timeout_seconds": 3600,
      "environment": {
        "PYTHONHASHSEED": "0"
      },
      "arguments": {
        "discover_outputs": true
      },
      "expected_output_files": [
        "patients.csv",
        "conditions.csv",
        "encounters.csv"
      ]
    }
  ],
  "output_root": "../runs",
  "report_formats": [
    "html",
    "json"
  ],
  "tags": [
    "all-modules",
    "compatibility",
    "combined-execution"
  ],
  "metadata": {
    "protocol": {
      "name": "IRYCIS Psynthea Scientific Validation",
      "version": 1
    },
    "validation": {
      "alpha": 0.05,
      "confidence_level": 0.95,
      "fdr_method": "benjamini-hochberg",
      "continuous_effect_margin": 0.2,
      "categorical_effect_margin": 0.1
    }
  }
}
